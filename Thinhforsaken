-- [3] UTILITY MODULE (TIỆN ÍCH HỖ TRỢ)
local Utils = {}

function Utils:Log(message)
    if TitanConfig.System.DebugMode then
        print("[TITAN-LOG]: " .. tostring(message))
    end
end

function Utils:IsAlive(player)
    if player and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character:FindFirstChild("HumanoidRootPart") then
        return player.Character.Humanoid.Health > 0
    end
    return false
end

function Utils:GetRoot(player)
    return self:IsAlive(player) and player.Character.HumanoidRootPart or nil
end

function Utils:GetTeam(player)
    if player.Team then return player.Team.Name end
    if player:GetAttribute("IsKiller") then return "Killer" end
    return "Survivor"
end

function Utils:IsKiller(player)
    local team = self:GetTeam(player)
    return team == "Killer" or player:GetAttribute("IsKiller") == true
end

