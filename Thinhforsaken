function PhysicsController:Update()
    if not Settings.Movement.Speed.Enabled then return end
    if not Utils:IsAlive(LocalPlayer) then return end
    
    local hum = LocalPlayer.Character.Humanoid
    local isRun = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
    local target = isRun and Settings.Movement.Speed.RunValue or Settings.Movement.Speed.WalkValue
    
    if hum.WalkSpeed ~= target then
        hum.WalkSpeed = target
    end
end

