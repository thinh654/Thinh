-- [MODULE 4] UTILITY LIBRARY (CÁC HÀM HỖ TRỢ)
-- ==============================================================================
local Utils = {}

function Utils:GetCharacter(player)
    return player and player.Character
end

function Utils:GetRoot(player)
    local char = self:GetCharacter(player)
    return char and char:FindFirstChild("HumanoidRootPart")
end

function Utils:GetHumanoid(player)
    local char = self:GetCharacter(player)
    return char and char:FindFirstChild("Humanoid")
end

function Utils:IsAlive(player)
    local hum = self:GetHumanoid(player)
    return hum and hum.Health > 0
end

function Utils:GetTeam(player)
    if player.Team then return player.Team.Name end
    if player:GetAttribute("IsKiller") then return "Killer" end
    return "Survivor"
end

function Utils:IsKiller(player)
    return self:GetTeam(player) == "Killer" or player:GetAttribute("IsKiller") == true
end

function Utils:GetDistance(p1, p2)
    return (p1 - p2).Magnitude
end

