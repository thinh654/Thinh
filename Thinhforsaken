-- [MODULE 5] DRAWING WRAPPER (HỆ THỐNG VẼ ĐỒ HỌA)
-- ==============================================================================
local DrawLib = {}
DrawLib.__index = DrawLib

function DrawLib.new(type, properties)
    local drawing = Drawing.new(type)
    for k, v in pairs(properties) do
        drawing[k] = v
    end
    return drawing
end

function DrawLib:Square(props) return self.new("Square", props) end
function DrawLib:Line(props) return self.new("Line", props) end
function DrawLib:Text(props) return self.new("Text", props) end
function DrawLib:Circle(props) return self.new("Circle", props) end

