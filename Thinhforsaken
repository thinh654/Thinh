local ServiceProvider = {}
ServiceProvider.__index = ServiceProvider
ServiceProvider.Cache = {}

function ServiceProvider:Get(service_name)
    if not self.Cache[service_name] then
        local success, service = pcall(game.GetService, game, service_name)
        if success then
            self.Cache[service_name] = service
        else
            return nil
        end
    end
    return self.Cache[service_name]
end

