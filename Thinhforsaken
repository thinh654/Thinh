function DrawEngine:Create(type, properties)
    local drawing = Drawing.new(type)
    for prop, val in pairs(properties) do
        drawing[prop] = val
    end
    return drawing
end

function DrawEngine:Line(props) return self:Create("Line", props) end
function DrawEngine:Square(props) return self:Create("Square", props) end
function DrawEngine:Text(props) return self:Create("Text", props) end
function DrawEngine:Circle(props) return self:Create("Circle", props) end

-- [5] ESP SYSTEM (SKELETON & BOX)
-- Hệ thống ESP chi tiết nhất từng được viết
local ESP_System = {}
ESP_System.Container = {}

-- Định nghĩa cấu trúc xương R15
ESP_System.BonesR15 = {
    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"}, {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"}, {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"}, {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"}, {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"}
}

function ESP_System:AddPlayer(player)
    if self.Container[player] then return end
    
    -- Khởi tạo các đối tượng vẽ cho người chơi này
    self.Container[player] = {
        Box = DrawEngine:Square({Thickness=1.5, Filled=false, Visible=false}),
        Name = DrawEngine:Text({Size=13, Center=true, Outline=true, Visible=false}),
        Tracer = DrawEngine:Line({Thickness=1, Visible=false}),
        HealthBar = DrawEngine:Line({Thickness=2, Visible=false}),
        Skeleton = {} -- Chứa các đường kẻ xương
    }
    
    -- Tạo sẵn 20 đường kẻ xương (dư một chút cũng không sao)
    for i=1, 20 do
        table.insert(self.Container[player].Skeleton, DrawEngine:Line({Thickness=1.5, Visible=false}))
    end
end

function ESP_System:RemovePlayer(player)
    if self.Container[player] then
        self.Container[player].Box:Remove()
        self.Container[player].Name:Remove()
        self.Container[player].Tracer:Remove()
        self.Container[player].HealthBar:Remove()
        for _, line in pairs(self.Container[player].Skeleton) do line:Remove() end
        self.Container[player] = nil
    end
end

function ESP_System:Update()
    if not TitanConfig.Visuals.MasterSwitch then
        for _, data in pairs(self.Container) do
            data.Box.Visible = false
            data.Name.Visible = false
            data.Tracer.Visible = false
            data.HealthBar.Visible = false
            for _, line in pairs(data.Skeleton) do line.Visible = false end
        end
        return
    end

    for player, data in pairs(self.Container) do
        local isVisible = false
        
        if player ~= LocalPlayer and Utils:IsAlive(player) then
            local root = player.Character.HumanoidRootPart
            local head = player.Character.Head
            local hum = player.Character.Humanoid
            
            local vector, onScreen = Camera:WorldToViewportPoint(root.Position)
            local dist = (Camera.CFrame.Position - root.Position).Magnitude
            
            -- Xác định màu
            local color = Utils:IsKiller(player) and TitanConfig.Visuals.Skeleton.ColorKiller or TitanConfig.Visuals.Skeleton.ColorSurvivor

            if onScreen and dist < TitanConfig.Visuals.RenderDistance then
                isVisible = true
                
                -- [[ BOX ESP ]]
                if TitanConfig.Visuals.Boxes.Enabled then
                    local size = 2500 / dist
                    data.Box.Size = Vector2.new(size * 0.7, size)
                    data.Box.Position = Vector2.new(vector.X - (size * 0.35), vector.Y - (size * 0.5))
                    data.Box.Color = color
                    data.Box.Visible = true
                else
                    data.Box.Visible = false
                end
                
                -- [[ NAME ESP ]]
                if TitanConfig.Visuals.Names.Enabled then
                    data.Name.Text = string.format("%s [%dm]", player.Name, math.floor(dist))
                    data.Name.Position = Vector2.new(vector.X, vector.Y - (2500/dist * 0.5) - 20)
                    data.Name.Color = color
                    data.Name.Visible = true
                else
                    data.Name.Visible = false
                end
                
                -- [[ TRACER ESP ]]
                if TitanConfig.Visuals.Tracers.Enabled then
                    data.Tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                    data.Tracer.To = Vector2.new(vector.X, vector.Y)
                    data.Tracer.Color = color
                    data.Tracer.Visible = true
                else
                    data.Tracer.Visible = false
                end
                
                -- [[ SKELETON ESP (XƯƠNG) ]]
                if TitanConfig.Visuals.Skeleton.Enabled then
                    local char = player.Character
                    local boneIndex = 1
                    for _, pair in pairs(self.BonesR15) do
                        local p1 = char:FindFirstChild(pair[1])
                        local p2 = char:FindFirstChild(pair[2])
                        if p1 and p2 then
                            local v1, vis1 = Camera:WorldToViewportPoint(p1.Position)
                            local v2, vis2 = Camera:WorldToViewportPoint(p2.Position)
                            if vis1 and vis2 and data.Skeleton[boneIndex] then
                                local line = data.Skeleton[boneIndex]
                                line.From = Vector2.new(v1.X, v1.Y)
                                line.To = Vector2.new(v2.X, v2.Y)
                                line.Color = color
                                line.Thickness = TitanConfig.Visuals.Skeleton.Thickness
                                line.Visible = true
                                boneIndex = boneIndex + 1
                            end
                        end
                    end
                    -- Ẩn các xương thừa
                    for i = boneIndex, #data.Skeleton do data.Skeleton[i].Visible = false end
                else
                    for _, l in pairs(data.Skeleton) do l.Visible = false end
                end
            end
        end
        
        if not isVisible then
            data.Box.Visible = false; data.Name.Visible = false
            data.Tracer.Visible = false; data.HealthBar.Visible = false
            for _, l in pairs(data.Skeleton) do l.Visible = false end
        end
    end
end

-- [6] THREAT ANALYZER (AUTO BLOCK LOGIC)
-- Hệ thống phân tích hành vi Killer
local ThreatEngine = {}
ThreatEngine.IsBlocking = false

function ThreatEngine:Scan()
    if not TitanConfig.Combat.AutoBlock.Enabled then return end
    
    local killer = nil
    local minDist = 9999
    
    -- Tìm Killer gần nhất
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and Utils:IsAlive(p) and Utils:IsKiller(p) then
            local d = (LocalPlayer.Character.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
            if d < minDist then
                minDist = d
                killer = p
            end
        end
    end
    
    if killer and minDist <= TitanConfig.Combat.AutoBlock.Distance then
        if self:IsAttacking(killer) then
            self:ExecuteBlock()
        end
    end
end

function ThreatEngine:IsAttacking(killer)
    local char = killer.Character
    -- Quét 1: Hitbox (Dao, Kiếm)
    for _, obj in pairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("hitbox") or n:find("blade") or n:find("weapon") then
                if obj.CanTouch and obj.Transparency > 0.5 then return true end
            end
        end
    end
    -- Quét 2: Animation
    local hum = char:FindFirstChild("Humanoid")
    if hum then
        local anim = hum:FindFirstChild("Animator")
        if anim then
            for _, t in pairs(anim:GetPlayingAnimationTracks()) do
                if t.Name:lower():find("attack") or t.Name:lower():find("swing") then return true end
            end
        end
    end
    return false
end

function ThreatEngine:ExecuteBlock()
    if self.IsBlocking then return end
    self.IsBlocking = true
    
    task.delay(TitanConfig.Combat.AutoBlock.Delay, function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        task.wait(0.15)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        task.wait(0.2)
        self.IsBlocking = false
    end)
end

-- [7] AIMBOT & PHYSICS ENGINE
local GameEngine = {}

function GameEngine:UpdateAimbot()
    if not TitanConfig.Combat.Aimbot.Enabled then return end
    
    local target = nil
    local closest = 9999
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and Utils:IsAlive(p) and Utils:IsKiller(p) then
            local root = p.Character.HumanoidRootPart
            local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
            local dist = (Vector2.new(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
            
            if onScreen and dist < closest then
                closest = dist
                target = p
            end
        end
    end
    
    if target then
        local targetPart = target.Character[TitanConfig.Combat.Aimbot.TargetPart]
        
        if TitanConfig.Combat.Aimbot.Mode == "Camera" then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
        elseif TitanConfig.Combat.Aimbot.Mode == "Character" then
            local myRoot = LocalPlayer.Character.HumanoidRootPart
            local lookPos = Vector3.new(targetPart.Position.X, myRoot.Position.Y, targetPart.Position.Z)
            myRoot.CFrame = CFrame.lookAt(myRoot.Position, lookPos)
        end
    end
end

function GameEngine:UpdatePhysics()
    if not Utils:IsAlive(LocalPlayer) then return end
    local hum = LocalPlayer.Character.Humanoid
    
    -- Speed Logic (Input)
    if TitanConfig.Movement.Speed.Enabled then
        local isRun = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
        local val = isRun and TitanConfig.Movement.Speed.RunValue or TitanConfig.Movement.Speed.WalkValue
        if hum.WalkSpeed ~= val then hum.WalkSpeed = val end
    end
    
    -- Auto Wall Jump
    if TitanConfig.Movement.WallJump.Enabled and hum.MoveDirection.Magnitude > 0 then
        local root = LocalPlayer.Character.HumanoidRootPart
        local ray = Workspace:Raycast(root.Position, root.CFrame.LookVector * 3, RaycastParams.new())
        if ray and ray.Instance and ray.Instance.CanCollide then hum.Jump = true end
    end
end

function GameEngine:AutoPickup()
    if not TitanConfig.Objective.AutoPickup then return end
    for _, p in pairs(Workspace:GetDescendants()) do
        if p:IsA("ProximityPrompt") then
            if (LocalPlayer.Character.HumanoidRootPart.Position - p.Parent.Position).Magnitude < p.MaxActivationDistance then
                if p.ActionText:lower():find("pick") or p.ActionText:lower():find("take") then
                    fireproximityprompt(p)
                end
            end
        end
    end
end

