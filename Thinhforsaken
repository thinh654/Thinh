local ObjectiveSystem = {}

function ObjectiveSystem:UpdateVisuals()
    if Settings.Visuals.Generator.Enabled then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj.Name:lower():find("generator") and not obj:FindFirstChild("GenESP") then
                local hasPrompt = false
                for _, p in pairs(obj:GetDescendants()) do
                    if p:IsA("ProximityPrompt") then hasPrompt = true break end
                end
                
                if hasPrompt then
                    local h = Instance.new("Highlight", obj)
                    h.Name = "GenESP"
                    h.FillColor = Settings.Visuals.Generator.Color
                    h.OutlineColor = Settings.Visuals.Generator.OutlineColor
                    h.FillTransparency = Settings.Visuals.Generator.FillTransparency
                end
            end
        end
    else
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:FindFirstChild("GenESP") then obj.GenESP:Destroy() end
        end
    end
end

function ObjectiveSystem:AutoRepair()
    if not Settings.Objective.AutoRepair then return end
    local char = LocalPlayer.Character
    if not char then return end
    
    for _, prompt in pairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local dist = Utils:GetDistance(char.HumanoidRootPart.Position, prompt.Parent.Position)
            if dist < prompt.MaxActivationDistance then
                local txt = prompt.ObjectText:lower() .. prompt.ActionText:lower()
                if txt:find("repair") or txt:find("generator") or txt:find("fix") then
                    fireproximityprompt(prompt)
                end
            end
        end
    end
end

-- ==============================================================================
-- [MODULE 8] THREAT ANALYZER (AUTO BLOCK LOGIC)
-- ==============================================================================
local ThreatSystem = {}
ThreatSystem.IsBlocking = false

function ThreatSystem:Scan()
    if not Settings.Combat.AutoBlock.Enabled then return end
    
    local killer = nil
    local minDist = 9999
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and Utils:IsAlive(p) and Utils:IsKiller(p) then
            local d = Utils:GetDistance(LocalPlayer.Character.HumanoidRootPart.Position, p.Character.HumanoidRootPart.Position)
            if d < minDist then
                minDist = d
                killer = p
            end
        end
    end
    
    if killer and minDist <= Settings.Combat.AutoBlock.Distance then
        if self:AnalyzeAttack(killer) then
            self:Block()
        end
    end
end

function ThreatSystem:AnalyzeAttack(killer)
    local char = killer.Character
    -- Scan Hitbox
    for _, obj in pairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("hitbox") or n:find("blade") or n:find("weapon") then
                if obj.CanTouch and obj.Transparency > 0.5 then return true end
            end
        end
    end
    -- Scan Animation
    local hum = char:FindFirstChild("Humanoid")
    if hum then
        local anim = hum:FindFirstChild("Animator")
        if anim then
            for _, t in pairs(anim:GetPlayingAnimationTracks()) do
                if t.Name:lower():find("attack") or t.Name:lower():find("swing") then return true end
            end
        end
    end
    return false
end

function ThreatSystem:Block()
    if self.IsBlocking then return end
    self.IsBlocking = true
    
    task.delay(Settings.Combat.AutoBlock.ReactionTime, function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        task.wait(0.15)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        task.wait(0.2)
        self.IsBlocking = false
    end)
end

